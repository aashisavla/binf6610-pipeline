rule filter:
    input: work/joint/cohort.vcf.gz, work/joint/cohort.vcf.gz.tbi, /courses/BINF6610.202710/data/refs/grch38-1000g/GRCh38_full_analysis_set_plus_decoy_hla.fa, /courses/BINF6610.202710/data/refs/grch38-1000g/GRCh38_full_analysis_set_plus_decoy_hla.fa.fai, /courses/BINF6610.202710/data/refs/grch38-1000g/GRCh38_full_analysis_set_plus_decoy_hla.dict
    output: results/cohort.filtered.vcf.gz, results/cohort.filtered.vcf.gz.tbi, results/variants.tsv
    log: logs/filter.log
    jobid: 1
    reason: Missing output files: results/cohort.filtered.vcf.gz, results/cohort.filtered.vcf.gz.tbi, results/variants.tsv; Input files updated by another job: work/joint/cohort.vcf.gz.tbi, work/joint/cohort.vcf.gz
    resources: tmpdir=<TBD>, mem_mb=8000, mem=8 GB, mem_mib=7630, disk_mb=6235, disk=6.24 GB, disk_mib=5947, slurm_account=binf6610.202710, slurm_partition=courses, runtime=60
Shell command: 
        G="gatk --java-options -Xmx6g"
        mkdir -p work/filter
        (
        $G SelectVariants -R /courses/BINF6610.202710/data/refs/grch38-1000g/GRCh38_full_analysis_set_plus_decoy_hla.fa -V work/joint/cohort.vcf.gz --select-type-to-include SNP -O work/filter/snps.vcf.gz
        $G SelectVariants -R /courses/BINF6610.202710/data/refs/grch38-1000g/GRCh38_full_analysis_set_plus_decoy_hla.fa -V work/joint/cohort.vcf.gz --select-type-to-include INDEL \
            --select-type-to-include MIXED -O work/filter/indels.vcf.gz

        $G VariantFiltration -R /courses/BINF6610.202710/data/refs/grch38-1000g/GRCh38_full_analysis_set_plus_decoy_hla.fa -V work/filter/snps.vcf.gz -O work/filter/snps.filtered.vcf.gz \
            --filter-expression "QD < 2.0"              --filter-name QD2 \
            --filter-expression "FS > 60.0"             --filter-name FS60 \
            --filter-expression "MQ < 40.0"             --filter-name MQ40 \
            --filter-expression "SOR > 3.0"             --filter-name SOR3 \
            --filter-expression "MQRankSum < -12.5"     --filter-name MQRankSum-12.5 \
            --filter-expression "ReadPosRankSum < -8.0" --filter-name ReadPosRankSum-8
        $G VariantFiltration -R /courses/BINF6610.202710/data/refs/grch38-1000g/GRCh38_full_analysis_set_plus_decoy_hla.fa -V work/filter/indels.vcf.gz -O work/filter/indels.filtered.vcf.gz \
            --filter-expression "QD < 2.0"               --filter-name QD2 \
            --filter-expression "FS > 200.0"             --filter-name FS200 \
            --filter-expression "ReadPosRankSum < -20.0" --filter-name ReadPosRankSum-20

        $G MergeVcfs -I work/filter/snps.filtered.vcf.gz -I work/filter/indels.filtered.vcf.gz -O results/cohort.filtered.vcf.gz
        ) 2> logs/filter.log

        printf 'chrom\tpos\tref\talt\tqual\tfilter\n' > results/variants.tsv
        bcftools query -f '%CHROM\t%POS\t%REF\t%ALT\t%QUAL\t%FILTER\n' results/cohort.filtered.vcf.gz >> results/variants.tsv
        
