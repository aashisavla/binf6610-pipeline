// The pipeline's name and version; the manifest copies both.
manifest {
    name    = 'variant-call'
    version = '1.0.0'
}

// What a run needs. Give them on the command line: --samplesheet, --ref, --region.
params {
    samplesheet = null
    ref         = null      // the FASTA; its .fai, BWA index and .dict sit beside it
    region      = null      // passed to GATK as -L: smoke_1mb, or chr20:1-10000000
    outdir      = 'results'
    platform    = 'laptop'

    // The software: one public image per kind of step, at the course environment's versions.
    containers = [
        tools  : 'community.wave.seqera.io/library/coreutils_gawk_gzip:7c58ccc2f9ca6bcc',
        fastqc : 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0',
        fastp  : 'community.wave.seqera.io/library/fastp:1.3.7--075357a9d5c82494',
        bwa    : 'community.wave.seqera.io/library/bwa_samtools:22527ddb3cc80fb3',
        gatk   : 'community.wave.seqera.io/library/gatk4_samtools_bcftools:1adede7d418fb46b',
        multiqc: 'quay.io/biocontainers/multiqc:1.35--pyhdfd78af_2'
    ]
}

// The output block in main.nf publishes into outputDir, as copies, not links into work/.
outputDir            = params.outdir
workflow.output.mode = 'copy'

process {
    cpus   = 1
    memory = '2 GB'
    shell  = ['/bin/bash', '-euo', 'pipefail']    // week 1's set -euo pipefail, for every task
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    fields    = 'task_id,name,status,exit,container,native_id,realtime,%cpu,peak_rss'
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}

profiles {
    docker {
        params.platform   = 'docker-local'
        docker.enabled    = true
        docker.runOptions = '--platform linux/amd64'
    }
    explorer {
        params.platform = 'singularity-hpc'
        process {
            executor       = 'slurm'
            queue          = 'courses'
            clusterOptions = '--account=binf6610.202710'
            time           = '30m'
            // 8 cores, as week 3's --cpus-per-task: bwa mem's batches depend on its thread
            // count, so the same count is what lets the records match last week's run.
            withName: 'BWA_MEM|HAPLOTYPECALLER' {
                cpus   = 8
                memory = '16 GB'
                time   = '1h'
            }
            withName: 'MARKDUPLICATES|JOINT_GENOTYPE|FILTER' {
                cpus   = 2
                memory = '8 GB'
                time   = '1h'
            }
            // fastp at week 3's thread count too, so its output reaches bwa in the same order.
            withName: 'FASTP' {
                cpus   = 8
                memory = '4 GB'
            }
            withName: 'MULTIQC' {
                memory = '4 GB'
            }
        }
        apptainer {
            enabled    = true
            autoMounts = true
        }
    }
}
