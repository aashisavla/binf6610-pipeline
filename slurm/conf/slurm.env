# slurm/conf/slurm.env — everything that is true only on Explorer.
# NAME=value lines, read with `source` by submit.sh and by both job scripts.
set -euo pipefail

PARTITION=courses
ACCOUNT=binf6610.202710
USER=${USER:-$(id -un)}                      # a job may start without $USER set

SAMPLESHEET=/courses/BINF6610.202710/data/samplesheet-variant8.csv
CONDA_MODULE=miniconda3/25.9.1
CONDA_ENV=/courses/BINF6610.202710/shared/env/binf6610
PIPELINE_DIR=${HOME}/binf6610-pipeline       # the folder the repository is cloned into

# A job submitted with TAG=x (submit.sh) is named w2-persample-x / w2-cohort-x and
# writes to its own run directory, so test runs never touch the real one.
RUN_TAG=${SLURM_JOB_NAME:-}
RUN_TAG=${RUN_TAG#w2-persample}
RUN_TAG=${RUN_TAG#w2-cohort}
RUN_ROOT=/scratch/${USER}/w2-run${RUN_TAG}   # where the run writes its files

# Resources, chosen from measurements (see RESOURCES.md). submit.sh passes these to
# sbatch; set one in front of `bash submit.sh` to override it for one submission.
PERSAMPLE_CPUS=${PERSAMPLE_CPUS:-8}
PERSAMPLE_MEM=${PERSAMPLE_MEM:-16G}
PERSAMPLE_TIME=${PERSAMPLE_TIME:-01:00:00}
COHORT_CPUS=${COHORT_CPUS:-4}
COHORT_MEM=${COHORT_MEM:-16G}
COHORT_TIME=${COHORT_TIME:-02:00:00}
